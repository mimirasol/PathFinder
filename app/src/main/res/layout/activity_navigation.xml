<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- MAP -->
    <com.google.android.gms.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <LinearLayout
        android:id="@+id/guideBox"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_margin="20dp"
        android:background="@drawable/white_morerounded_corners"
        android:elevation="40dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:id="@+id/txtNavGuide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins"
            android:text="Walking to Destination"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textAlignment="center"
            android:gravity="center" />

    </LinearLayout>

    <!-- BOTTOM BAR — id added so we can apply insets in code -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/white_rounded_corners"
        android:elevation="10dp"
        android:padding="20dp"
        android:orientation="vertical">

        <!-- TOP ROW (Distance + Time + Where Am I Button) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Distance + Time Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="350 m"
                    android:textSize="30sp"
                    android:fontFamily="@font/gabarito"
                    android:textColor="@color/black"/>

                <TextView
                    android:id="@+id/txtTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5 min walk"
                    android:textSize="16sp"
                    android:fontFamily="@font/poppins"
                    android:textColor="#757575"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>

            <!-- WHERE AM I BUTTON -->
            <Button
                android:id="@+id/btnWhereAmI"
                android:layout_width="180dp"
                android:layout_height="60dp"
                android:text="Where Am I?"
                android:textSize="16sp"
                android:fontFamily="@font/poppins_bold"
                android:textColor="#9b8bf4"
                app:strokeColor="#9b8bf4"
                app:strokeWidth="3dp"
                app:backgroundTint="@android:color/transparent"/>

        </LinearLayout>

        <!-- END NAVIGATION BUTTON -->
        <Button
            android:id="@+id/btnEnd"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="20dp"
            android:text="End Navigation"
            android:textSize="18sp"
            android:fontFamily="@font/poppins_bold"
            android:backgroundTint="#0073e6"
            android:textColor="@android:color/white"/>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>