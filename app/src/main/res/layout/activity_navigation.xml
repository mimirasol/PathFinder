<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- MAP -->
    <com.google.android.gms.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- TOP STACK — guide box + alert banner stacked vertically so they never overlap -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="16dp">

        <!-- GUIDANCE BANNER -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="12dp"
            app:cardCornerRadius="20dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardElevation="6dp">

            <LinearLayout
                android:id="@+id/guideBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="18dp">

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="⬆"
                    android:textSize="24sp"
                    android:gravity="center"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:id="@+id/txtNavGuide"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/poppins_bold"
                    android:text="Walking to Destination"
                    android:textColor="#1A202C"
                    android:textSize="17sp"
                    android:lineSpacingMultiplier="1.2"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- ALERT BANNER — directly below guide box, hidden by default -->
        <androidx.cardview.widget.CardView
            android:id="@+id/alertBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:elevation="14dp"
            android:visibility="gone"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#1A202C">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="18dp"
                android:paddingVertical="12dp">

                <TextView
                    android:id="@+id/txtAlertIcon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:text="⚠️"
                    android:textSize="20sp"
                    android:gravity="center"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:id="@+id/txtAlertMessage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/poppins_bold"
                    android:text="Crosswalk ahead"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:lineSpacingMultiplier="1.2"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <!-- BOTTOM BAR -->
    <androidx.cardview.widget.CardView
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:cardCornerRadius="0dp"
        app:cardElevation="16dp"
        app:cardBackgroundColor="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="20dp"
            android:paddingHorizontal="20dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtDistance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="350 m"
                        android:textSize="36sp"
                        android:fontFamily="@font/gabarito"
                        android:textColor="#1A202C"
                        android:includeFontPadding="false"/>

                    <TextView
                        android:id="@+id/txtTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5 min walk"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins"
                        android:textColor="#8A94A6"
                        android:layout_marginTop="2dp"/>

                </LinearLayout>

                <Button
                    android:id="@+id/btnWhereAmI"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:minWidth="148dp"
                    android:text="📍 Where Am I?"
                    android:textSize="14sp"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="#5B4FCF"
                    app:strokeColor="#C4B9FF"
                    app:strokeWidth="2dp"
                    app:backgroundTint="#F3F0FF"
                    app:cornerRadius="14dp"
                    android:stateListAnimator="@null"/>

            </LinearLayout>

            <Button
                android:id="@+id/btnEnd"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="End Navigation"
                android:textSize="18sp"
                android:fontFamily="@font/poppins_bold"
                android:backgroundTint="#0073E6"
                android:textColor="#FFFFFF"
                app:cornerRadius="16dp"
                android:stateListAnimator="@null"
                android:elevation="2dp"/>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>