<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- MAP BACKGROUND -->
    <com.google.android.gms.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- BOTTOM SHEET -->
    <LinearLayout
        android:id="@+id/bottomSheet"
        android:layout_width="match_parent"
        android:layout_height="420dp"
        android:orientation="vertical"
        android:background="@drawable/white_rounded_corners"
        android:elevation="10dp"
        android:outlineProvider="background"
        android:translationZ="6dp"
        android:padding="16dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <!-- Drag Handle -->
        <View
            android:id="@+id/blackline"
            android:layout_width="350dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:background="@drawable/black_rounded_corners"
            android:layout_marginBottom="12dp"/>

        <!-- Scrollable Content -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/gabarito"
                    android:text="Where would you like to go today?"
                    android:textSize="35dp"
                    android:layout_marginTop="10dp"/>

                <Button
                    android:id="@+id/btnStart"
                    android:layout_width="340dp"
                    android:layout_height="70dp"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="#0073e6"
                    android:fontFamily="@font/poppins_bold"
                    android:text="Start"
                    android:textSize="25dp" />

                <Button
                    android:id="@+id/btnWhereAmI"
                    android:layout_width="340dp"
                    android:layout_height="70dp"
                    android:text="Where Am I?"
                    android:fontFamily="@font/poppins_bold"
                    android:textSize="25dp"
                    android:layout_marginTop="12dp"
                    android:textColor="#9b8bf4"
                    app:strokeColor="#9b8bf4"
                    app:strokeWidth="3dp"
                    app:backgroundTint="@android:color/transparent"/>

                <Button
                    android:id="@+id/btnSOS"
                    android:layout_width="340dp"
                    android:layout_height="70dp"
                    android:text="SOS"
                    android:fontFamily="@font/poppins_bold"
                    android:textSize="25dp"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="#BD0404"/>

            </LinearLayout>
        </ScrollView>

    </LinearLayout>

    <!-- SEARCH BAR -->
    <com.google.android.material.textfield.MaterialAutoCompleteTextView
        android:id="@+id/txtDestination"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_margin="20dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:hint="Enter destination"
        android:textColorHint="#757575"
        android:inputType="text"
        android:fontFamily="@font/poppins"
        android:textColor="@color/black"
        android:background="@drawable/white_morerounded_corners"
    android:elevation="40dp"
    android:outlineProvider="background"
    android:dropDownVerticalOffset="10dp"
    android:popupBackground="@drawable/white_rounded_corners" />


</androidx.coordinatorlayout.widget.CoordinatorLayout>