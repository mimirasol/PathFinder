<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- MAP BACKGROUND -->
    <com.google.android.gms.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Map" />

    <!-- BOTTOM SHEET -->
    <LinearLayout
        android:id="@+id/bottomSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/white_morerounded_corners"
        android:elevation="10dp"
        android:outlineProvider="background"
        android:translationZ="6dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        android:paddingHorizontal="20dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:behavior_peekHeight="230dp"
        app:behavior_hideable="false">

        <!-- Drag Handle -->
        <View
            android:id="@+id/blackline"
            android:layout_width="48dp"
            android:layout_height="5dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/black_rounded_corners"
            android:layout_marginBottom="16dp"
            android:alpha="0.18"/>

        <!-- Scrollable Content -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Greeting -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/gabarito"
                    android:text="Where to today?"
                    android:textSize="30sp"
                    android:textColor="#1A202C"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="20dp"/>

                <!-- START — primary full-width CTA -->
                <Button
                    android:id="@+id/btnStart"
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:backgroundTint="#0073E6"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="#FFFFFF"
                    android:text="▶  Start Navigation"
                    android:textSize="20sp"
                    android:layout_marginBottom="10dp"
                    app:cornerRadius="16dp"
                    android:stateListAnimator="@null"
                    android:elevation="2dp" />

                <!-- WHERE AM I + SOS — side by side row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <Button
                        android:id="@+id/btnWhereAmI"
                        android:layout_width="0dp"
                        android:layout_height="68dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="📍 Where Am I?"
                        android:fontFamily="@font/poppins_bold"
                        android:textSize="16sp"
                        android:textColor="#5B4FCF"
                        app:strokeColor="#C4B9FF"
                        app:strokeWidth="2dp"
                        app:backgroundTint="#F3F0FF"
                        app:cornerRadius="16dp"
                        android:stateListAnimator="@null"/>

                    <Button
                        android:id="@+id/btnSOS"
                        android:layout_width="0dp"
                        android:layout_height="68dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="🚨 SOS"
                        android:fontFamily="@font/poppins_bold"
                        android:textSize="20sp"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#D32F2F"
                        app:cornerRadius="16dp"
                        android:stateListAnimator="@null"
                        android:elevation="2dp"/>

                </LinearLayout>

                <!-- COMPANION — full width outlined -->
                <Button
                    android:id="@+id/btnCompanion"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:text="👥  Companion"
                    android:fontFamily="@font/poppins_bold"
                    android:textSize="18sp"
                    android:textColor="#5B4FCF"
                    app:strokeColor="#C4B9FF"
                    app:strokeWidth="2dp"
                    app:backgroundTint="#F3F0FF"
                    app:cornerRadius="16dp"
                    android:layout_marginBottom="8dp"
                    android:stateListAnimator="@null"/>

                <!-- LOG OUT — subtle text link -->
                <Button
                    android:id="@+id/btnLogout"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="Log Out"
                    android:fontFamily="@font/poppins"
                    android:textSize="13sp"
                    android:textColor="#B0B8C8"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    app:backgroundTint="@android:color/transparent"
                    android:stateListAnimator="@null"/>

            </LinearLayout>
        </ScrollView>

    </LinearLayout>

    <!-- SEARCH BAR — floating pill at top -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="16dp"
        android:elevation="40dp"
        android:outlineProvider="background">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/txtDestination"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="56dp"
            android:paddingEnd="56dp"
            android:hint="Search destination…"
            android:textColorHint="#9AA3B0"
            android:inputType="text"
            android:fontFamily="@font/poppins"
            android:textColor="#1A202C"
            android:textSize="15sp"
            android:background="@drawable/white_morerounded_corners"
            android:dropDownVerticalOffset="8dp"
            android:popupBackground="@drawable/white_rounded_corners" />

        <!-- Search icon on the left -->
        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="18dp"
            android:src="@drawable/ic_search"
            android:alpha="0.35"
            android:contentDescription="Search"
            android:scaleType="fitCenter" />

        <!-- Clear (X) button on the right -->
        <ImageButton
            android:id="@+id/btnClearSearch"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:contentDescription="Clear search"
            android:visibility="gone" />

    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>