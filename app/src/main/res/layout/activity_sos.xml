<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sosRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF5F5">

    <!-- Soft red radial glow behind the button — purely decorative -->
    <View
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:background="@drawable/sos_glow"
        android:alpha="0.18"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="60dp" />

    <!-- Close button — top left -->
    <ImageButton
        android:id="@+id/btnClose"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_close"
        android:contentDescription="Close"
        android:tint="#CC0000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp" />

    <!-- Settings button — top right -->
    <ImageButton
        android:id="@+id/btnSettings"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_settings"
        android:contentDescription="Emergency Contacts Settings"
        android:tint="#CC0000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp" />

    <!-- Screen title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Emergency SOS"
        android:fontFamily="@font/gabarito"
        android:textSize="22sp"
        android:textColor="#CC0000"
        android:letterSpacing="0.02"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="22dp" />

    <!-- Countdown — shown during countdown, hidden otherwise -->
    <TextView
        android:id="@+id/txtCountdown"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Sending in 10 seconds…"
        android:fontFamily="@font/poppins_bold"
        android:textSize="26sp"
        android:textColor="#CC0000"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnSosRing"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="32dp" />

    <!-- Outer pulse ring -->
    <View
        android:id="@+id/btnSosRing"
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:background="@drawable/sos_ring"
        android:alpha="0.55"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="72dp" />

    <!-- Inner SOS button -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/btnSos"
        android:layout_width="174dp"
        android:layout_height="174dp"
        android:background="@drawable/sos_button"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:elevation="8dp"
        app:layout_constraintTop_toTopOf="@id/btnSosRing"
        app:layout_constraintBottom_toBottomOf="@id/btnSosRing"
        app:layout_constraintStart_toStartOf="@id/btnSosRing"
        app:layout_constraintEnd_toEndOf="@id/btnSosRing">

        <TextView
            android:id="@+id/txtSosLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SOS"
            android:fontFamily="@font/gabarito"
            android:textSize="42sp"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:letterSpacing="0.05"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/txtSosSub"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/txtSosSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hold to send"
            android:fontFamily="@font/poppins"
            android:textSize="12sp"
            android:textColor="#FFCCCC"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/txtSosLabel"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="2dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Subtitle at bottom -->
    <TextView
        android:id="@+id/txtSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Your location will be sent to your emergency contacts and companion"
        android:fontFamily="@font/poppins"
        android:textSize="14sp"
        android:textColor="#B05050"
        android:gravity="center"
        android:lineSpacingMultiplier="1.4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="52dp"
        android:layout_marginHorizontal="40dp" />

</androidx.constraintlayout.widget.ConstraintLayout>