<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/white_morerounded_corners"
    android:paddingTop="8dp"
    android:paddingBottom="24dp">

    <!-- Drag handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/black_rounded_corners"
        android:alpha="0.15" />

    <!-- Street name -->
    <TextView
        android:id="@+id/txtStreetName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/gabarito"
        android:textSize="26sp"
        android:textColor="#1A202C"
        android:gravity="center"
        android:paddingHorizontal="28dp"
        android:layout_marginBottom="4dp"
        android:text="Session Road" />

    <!-- Subtitle -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins"
        android:text="Nearby landmarks"
        android:textSize="13sp"
        android:textColor="#8A94A6"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <!-- Landmark list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvLandmarks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:nestedScrollingEnabled="false" />

    <!-- Close button -->
    <Button
        android:id="@+id/btnCloseLandmarks"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="20dp"
        android:layout_marginHorizontal="20dp"
        android:text="Got it"
        android:fontFamily="@font/poppins_bold"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#0073E6"
        app:cornerRadius="14dp"
        android:stateListAnimator="@null"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

</LinearLayout>
